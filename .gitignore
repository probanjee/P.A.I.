# ── Secrets. Committing any of these publishes them. ──────────────────────────
config/api_keys.json
config/certs/
config/whatsapp_web/
**/token*.json
**/client_secret*.json
*credentials*.json
.env
.env.*

# ── Personal data the assistant accumulates about you ─────────────────────────
memory/long_term.json
memory/*.db

# ── Python build noise ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Editors and operating systems ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ── Runtime output ────────────────────────────────────────────────────────────
*.log
logs/
downloads/
screenshots/